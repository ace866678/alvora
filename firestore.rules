rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Only open or unverified opportunity records are publicly readable.
    // Listing writes are restricted to trusted admins with a custom claim.
    match /opportunities/{opportunityId} {
      allow read: if resource.data.status in ["open", "unverified"];
      allow create, update, delete: if isAdmin();
    }

    // Users can read and edit only their own profile document.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /savedOpportunities/{opportunityId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Default-deny any collection not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
